generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email    String    @unique
  password String
  theatres Theatre[]

  isActive      Boolean @default(true)
  emailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("roles")
}

model Movie {
  id          String   @id @default(cuid())
  title       String
  language    String
  genre       String
  description String?
  duration    Int
  releaseDate DateTime
  certificate String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  shows     Show[]

  @@map("movies")
}

model Theatre {
  id      String @id @default(cuid())
  name    String
  address String
  city    String
  state   String
  pincode String

  adminId String
  admin   User     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  screens Screen[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
  @@map("theatres")
}

model Screen {
  id        String   @id @default(cuid())
  name      String
  theatreId String
  theatre   Theatre  @relation(fields: [theatreId], references: [id], onDelete: Restrict)
  seats     Seat[]
  shows     Show[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([theatreId])
  @@map("screens")
}

enum SeatType {
  REGULAR
  PREMIUM
  RECLINER
}

model Seat {
  id        String   @id @default(cuid())
  screenId  String
  screen    Screen   @relation(fields: [screenId], references: [id], onDelete: Restrict)
  row       String
  number    Int
  type      SeatType
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([screenId, row, number])
  @@map("seats")
}

model Show {
  id        String   @id @default(cuid())
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Restrict)
  screenId  String
  screen    Screen   @relation(fields: [screenId], references: [id], onDelete: Restrict)
  startTime DateTime
  endTime   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([movieId])
  @@index([screenId])
  @@map("shows")
}
